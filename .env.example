NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 구글 메일(Gmail) SMTP 발신 설정 (추천)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_16digit_google_app_password
SMTP_FROM=your_gmail@gmail.com
SMTP_FROM_NAME="연차 관리 시스템"

# 또는 네이버 메일 SMTP 발신 설정
# SMTP_HOST=smtp.naver.com
# SMTP_PORT=465
# SMTP_USER=your_id@naver.com
# SMTP_PASSWORD=your_naver_password_or_app_password
# SMTP_FROM=your_id@naver.com
# SMTP_FROM_NAME="연차 관리 시스템"
